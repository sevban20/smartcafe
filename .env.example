# --- Veritabani ---
# Supabase: Project Settings > Database > Connection string (URI)
# Neon:     Dashboard > Connection Details > Connection string
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST:5432/postgres?sslmode=require"

# Supabase'in "Transaction pooler" adresini DATABASE_URL olarak kullaniyorsan,
# migration'lar icin dogrudan baglantiyi da tanimla ve
# prisma/schema.prisma icindeki directUrl satirini ac.
# DIRECT_URL="postgresql://KULLANICI:SIFRE@HOST:5432/postgres?sslmode=require"

# --- NextAuth ---
# Uretmek icin: openssl rand -base64 32
NEXTAUTH_SECRET="buraya-uzun-rastgele-bir-anahtar"
NEXTAUTH_URL="http://localhost:3000"

# --- Ilk yonetici hesabi (seed icin) ---
ADMIN_EMAIL="admin@smartcafe.local"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Kafe Sahibi"
STAFF_EMAIL="barista@smartcafe.local"
STAFF_PASSWORD="barista123"

# --- Push bildirimleri (opsiyonel) ---
# Anahtar uretmek icin: npm run push:keys
# Bos birakirsan uygulama calisir, sadece push bildirimi gonderilmez.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@smartcafe.local"

# --- Saat dilimi (opsiyonel) ---
# Gunluk/aylik ciro sinirlari bu saat dilimine gore hesaplanir.
# Bos birakirsan Europe/Istanbul kullanilir.
NEXT_PUBLIC_APP_TIMEZONE="Europe/Istanbul"
